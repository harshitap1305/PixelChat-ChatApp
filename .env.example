# Group Chat App — Configuration Template
# Copy this file to .env and fill in your own values

PORT=5000 #port on which backend runs
# Backend (FastAPI WebSocket server)
BACKEND_PORT=5000 #port on which frontend send request (this is due to port forwarding configuration, so which frontend send request on BACKEND_PORT, backend server running on PORT receives it and serve)

# Frontend (static file server)
FRONTEND_PORT=3000

# Room empty cleanup timeout in seconds (default 300 sec)
CLEANUP_TIMEOUT=300

# 256-bit AES-GCM group key (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AES_GROUP_KEY=<generate-with-python-secrets-token-hex-32>

# Server-side HMAC-SHA256 secret for database tamper detection (hex, 64 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=<generate-with-python-secrets-token-hex-32>

# ── Load Balancer Setup (multi-machine deployment) ────────────────────────────

# Sys1 — frontend + load balancer machine (.env for Sys1):
#   FRONTEND_PORT=3000        # serve.py listens here  → accessed via :3269
#   BACKEND_PORT=5269         # JS connects to LB at this external port
#   PORT=5000                 # LB listens here        → accessed via :5269

# Sys2 — Backend-1 + DB host (.env for Sys2):
#   PORT=5000
#   DB_PROXY_PORT=6000        # DB proxy listens here  → accessed via :<forwarded>
#   DB_PATH=                  # leave blank → uses local server/chat.db
#   UPLOAD_DIR=               # leave blank → uses local server/uploads/

# Sys3 / Sys4 — Backend-2 and Backend-3 (.env for Sys3 and Sys4):
#   PORT=5000
#   DB_PROXY_URL=https://10.1.75.51:<sys2_db_proxy_forwarded_port>
#   (No DB_PATH or UPLOAD_DIR needed — everything goes through the proxy)

# Path to shared SQLite database (leave blank on Sys2 — it hosts the DB)
# On Sys3/Sys4: not needed if using DB_PROXY_URL
DB_PATH=

# Path to shared file upload directory (leave blank on Sys2)
# On Sys3/Sys4: uploads go through the backend → for now each backend stores locally
UPLOAD_DIR=

# Human-readable backend name (shown in LB logs)
BACKEND_NAME=backend-1

# DB Proxy Server port (set on Sys2 ONLY — where the proxy server runs)
DB_PROXY_PORT=6000

# DB Proxy URL (set on Sys3 and Sys4 ONLY — points to Sys2's proxy)
# Ask your professor which port Sys2's 6000 is forwarded to.
DB_PROXY_URL=
